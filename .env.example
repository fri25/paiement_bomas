# Copiez ce fichier en .env et adaptez les valeurs. Ne versionnez jamais .env.

# local | production
APP_ENV=local
APP_DEBUG=true
# URL publique de l'application, sans "/" final (sert aux liens et au retour FedaPay)
APP_URL=http://localhost/paiement

# Base de données MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=contribution_scolaire
DB_USER=root
DB_PASSWORD=

# FedaPay — https://app.fedapay.com (Paramètres > API)
# Clé SECRÈTE (obligatoire) : reste sur le serveur. sk_sandbox_… pour tester, sk_live_… en production.
FEDAPAY_SECRET_KEY=
# sandbox | live
FEDAPAY_ENVIRONMENT=sandbox
# Secret de signature du webhook (Paramètres > Webhooks), URL : {APP_URL}/webhooks/fedapay
FEDAPAY_WEBHOOK_SECRET=

# Mot de passe du panneau d'administration (Directeur)
ADMIN_PASSWORD=directeur2026
